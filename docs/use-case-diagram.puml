@startuml
left to right direction
skinparam packageStyle rectangle

actor "Passenger" as passenger
actor "Elevator Dispatch System" as dispatchSystem
actor "Maintenance Team" as maintenance
actor "Building Security" as security
actor "Daily Log Scheduler" as timer <<Scheduled Actor>>

rectangle "Smart Elevator Dispatching System" {
  usecase "Request Elevator" as UC1
  usecase "Dispatch Elevator" as UC2
  usecase "Handle Elevator Emergency" as UC3
  usecase "Update Floor Display" as UC4
  usecase "Board Elevator" as UC5
  usecase "Trigger Overweight Alarm" as UC6
  usecase "Generate Daily Usage Log" as UC7
  
  passenger --> UC1
  passenger --> UC5
  passenger --> UC3
  
  dispatchSystem --> UC2
  dispatchSystem --> UC3
  
  maintenance --> UC3
  security --> UC3
  timer --> UC7
  
  ' Include relationship
  UC1 ..> UC4 : <<include>>
  
  ' Extend relationship with Guard condition
  UC5 <.. UC6 : <<extend>>\nCondition: {weight > max capacity}
}
@enduml
